# Copy to .env.local and fill in what you need.
# Every variable is optional for local development.

# Public origin of the site, used for canonical URLs, Open Graph tags, the sitemap and robots.txt.
# Defaults to https://gauthamkrishna.dev when unset.
APP_URL=http://localhost:1408

# Base URL of the shadcn component registry.
# pnpm registry:build writes it into src/__registry__ and public/r in place of <registryBaseUrl>.
# The registry script does not read .env files, so export it in the shell when you need it.
# Defaults to https://gauthamkrishna.dev/r when unset or empty.
REGISTRY_URL=

# Google Apps Script web app URL that receives contact form submissions.
# See scripts/google-apps-script.js for the script to deploy.
# When unset, the form shows "Contact form is not configured" instead of sending.
NEXT_PUBLIC_CONTACT_FORM_URL=

# Page the screenshot script (pnpm capture) opens.
# Like REGISTRY_URL, export it in the shell, since the script does not read .env files.
# Defaults to http://localhost:1408 when unset.
URL=
